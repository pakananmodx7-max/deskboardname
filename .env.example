VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Drive API Integration — optional. Only needed if you want
# teachers to pick files directly from Google Drive (see
# docs/GOOGLE_DRIVE_SETUP.md). Public, HTTP-referrer-restricted API key
# for the Google Picker widget — never a secret. The OAuth client
# id/secret and Drive access tokens are configured separately as
# Supabase Edge Function secrets, never as VITE_ variables (they must
# never reach the browser).
VITE_GOOGLE_API_KEY=
# The Google Cloud project's NUMERIC project number (not the project id,
# OAuth client id, or API key) — required by the Google Picker's
# setAppId() when using the drive.file scope. Also not a secret. Find it
# in Cloud Console: project selector dropdown, or IAM & Admin > Settings.
VITE_GOOGLE_APP_ID=
